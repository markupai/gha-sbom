{
  "name": "gha-sbom",
  "version": "1.0.0",
  "private": true,
  "description": "Generate, stamp, attest and store SBOMs in GitHub Actions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markupai/gha-sbom.git"
  },
  "license": "UNLICENSED",
  "author": "Markup AI",
  "type": "module",
  "scripts": {
    "all": "npm run format:check && npm run lint:check && npm run type-check && npm test && npm run package",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "prettier-plugin-packagejson": "3.0.2",
    "rollup": "4.63.3",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "engines": {
    "node": ">=24"
  }
}
